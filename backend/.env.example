DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventhub
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
# When NODE_ENV=production, set to true to disable API/auth rate limits (e.g. local prod-mode testing)
# DISABLE_RATE_LIMIT=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AWS_REGION=us-west-2
AWS_S3_BUCKET=eventhub-uploads
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Google Calendar OAuth (optional — enables "Connect Google Calendar" + API add-to-calendar)
# Create OAuth Client (Desktop or Web) at https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API for the project.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must match Authorized redirect URIs in Google Cloud (e.g. http://localhost:3001/api/v1/integrations/google-calendar/callback)
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google-calendar/callback
